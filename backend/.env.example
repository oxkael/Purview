HOST=127.0.0.1
PORT=3001
# Development-only local planning bypass. Effective only when NODE_ENV=development;
# never use it to represent that a user's jurisdiction has been verified.
JURISDICTION_DEV_OVERRIDE=false
# Robinhood Chain 4663 RPC with archive/historical-state access, used only as
# the source when starting a new local Anvil fork. Keep credentialed URLs local.
ANVIL_FORK_SOURCE_RPC_URL=
# Backend RPC target. Set to http://127.0.0.1:8545 for the local Anvil fork;
# set to Robinhood's RPC (or your provider URL) for live read-only chain data.
# This is server-side config; never expose a credentialed RPC URL to the browser.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Required for plan liveness checks: use an independently operated RPC host,
# different from ROBINHOOD_RPC_URL. Plans fail closed when missing or unhealthy.
ROBINHOOD_LIVENESS_RPC_URL=
# Conservative liveness policy defaults (seconds).
ROBINHOOD_MAX_BLOCK_AGE_SECONDS=60
ROBINHOOD_MAX_HEAD_SKEW_SECONDS=30
ZEROX_API_KEY=
# Read-only execution readiness endpoint checks bytecode at this address; it never executes.
PURVIEW_ROUTER_ADDRESS=
# Dedicated backend execution signer. Leave blank until the router is deployed,
# its immutable signer address is verified, and all execution gates are wired.
# Never use your wallet's private key or share this secret in chat.
PURVIEW_EXECUTION_SIGNER_PRIVATE_KEY=
# Enables only eth_call router simulation on loopback Anvil. It cannot submit transactions.
PURVIEW_LOCAL_FORK_SIMULATION=false
# HMAC secret for short-lived, integrity-protected plan recheck references.
# Generate at least 32 random bytes; this reference does not authorize execution.
PURVIEW_PLAN_REFERENCE_SECRET=
# Optional override after Chainlink confirms the Robinhood Chain NVDA/USD heartbeat.
# Blank uses the product-owner-approved provisional online value of 3600 seconds.
# The backend enforces heartbeat + 60 seconds. Replace the provisional value when verified.
NVDA_ORACLE_HEARTBEAT_SECONDS=
# Closed-market sell-only stale-price bounds (provisional product policy, not Chainlink-published values).
# Blank uses 72h for ordinary closures and 96h for a three-day holiday weekend.
# Never use these closed-market exceptions to permit borrow or hybrid plans.
NVDA_ORACLE_CLOSED_SELL_MAX_AGE_SECONDS=
NVDA_ORACLE_HOLIDAY_SELL_MAX_AGE_SECONDS=
