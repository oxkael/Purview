HOST=127.0.0.1
PORT=3001
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Required for plan liveness checks: use an independently operated RPC host,
# different from ROBINHOOD_RPC_URL. Plans fail closed when missing or unhealthy.
ROBINHOOD_LIVENESS_RPC_URL=
# Conservative liveness policy defaults (seconds).
ROBINHOOD_MAX_BLOCK_AGE_SECONDS=60
ROBINHOOD_MAX_HEAD_SKEW_SECONDS=30
ZEROX_API_KEY=
# Optional override after Chainlink confirms the Robinhood Chain NVDA/USD heartbeat.
# Blank uses the product-owner-approved provisional online value of 3600 seconds.
# The backend enforces heartbeat + 60 seconds. Replace the provisional value when verified.
NVDA_ORACLE_HEARTBEAT_SECONDS=
# Closed-market sell-only stale-price bounds (provisional product policy, not Chainlink-published values).
# Blank uses 72h for ordinary closures and 96h for a three-day holiday weekend.
# Never use these closed-market exceptions to permit borrow or hybrid plans.
NVDA_ORACLE_CLOSED_SELL_MAX_AGE_SECONDS=
NVDA_ORACLE_HOLIDAY_SELL_MAX_AGE_SECONDS=
